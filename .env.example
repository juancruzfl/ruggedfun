DATABASE_URL=postgres://ruggedfun:ruggedfun@localhost:5432/ruggedfun

# Engine
ENGINE_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Seconds between token launches (random in range)
LAUNCH_MIN_SECONDS=5
LAUNCH_MAX_SECONDS=20
# Tokens created (backdated) when the market starts empty
BOOTSTRAP_TOKENS=12
# Simulated confirmation time for player trades, in ms (5% of trades take 2-3x longer). Set both to 0 to turn off.
TRADE_DELAY_MIN_MS=400
TRADE_DELAY_MAX_MS=1500
# Max bot trades per second across all tokens (0 = no bots)
BOT_TRADES_PER_SECOND=6

# Web
# Public site URL, used for absolute link-preview URLs (profile PnL cards). Defaults to https://ruggedfun.xyz.
SITE_URL=https://ruggedfun.xyz
NEXT_PUBLIC_ENGINE_URL=http://localhost:3001

# Shared by engine and web for the internal trade endpoint (use a long random value)
ENGINE_SECRET=change-me
ENGINE_INTERNAL_URL=http://localhost:3001
